{
  "name": "pi-emphasis",
  "private": true,
  "version": "0.2.0",
  "description": "Colored status pills with icons, labeled headings and colored bold for assistant replies in Pi's terminal, with the rules that teach the agent to write them.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi", "markdown", "terminal", "pills"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-emphasis.git"
  },
  "engines": {
    "node": ">=24.22.3 <25 || >=26.13.1"
  },
  "packageManager": "npm@12.2.0",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "README.md", "LICENSE"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:lock": "node -e \"process.exit(/workos|socket-firewall/i.test(require('fs').readFileSync('package-lock.json','utf8')) ? 1 : 0)\"",
    "check": "npm run check:lock && npm run typecheck && npm test",
    "check:compat": "npm run check"
  }
}
